#!/bin/sh
# Enables the user service for every user's systemd instance. A system without systemd (a container) is skipped.
set -e

case "$1" in
  configure)
    if command -v systemctl >/dev/null 2>&1; then
      systemctl --global enable gpu-game-guard.service >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
